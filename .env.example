# ==============================================================================
# Environment Configuration: Multilingual AI Agricultural Assistant
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL recommended)
# ------------------------------------------------------------------------------
# Neon provides managed pgvector and SSL encryption out of the box.
# Copy your connection string from https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Local Docker PostgreSQL (Port 5433 by default in docker-compose.yml)
# DB_NAME=agridb
# DB_USER=agriuser
# DB_PASSWORD=agripass
# DB_PORT=5433
# DB_HOST=localhost

# ------------------------------------------------------------------------------
# 2. WEATHER API CONFIGURATION
# ------------------------------------------------------------------------------
WEATHER_API_KEY=your_weatherapi_key_here

# ------------------------------------------------------------------------------
# 3. AI PROVIDER & LOCAL RAG CONFIGURATION (Zero Internet Scraping)
# ------------------------------------------------------------------------------
# AI Provider: 'ollama' (recommended for local RAG) or 'gemini'
AI_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 4. MULTI-DEVICE RAG DEPLOYMENT (Device A vs Device B)
# ------------------------------------------------------------------------------
# When running everything on one machine:
# RETRIEVAL_SERVICE_URL=http://localhost:8083
# OLLAMA_URL=http://localhost:11434

# When running RAG on a separate device (Device B, e.g. GPU machine / Ollama host):
# Replace 192.168.1.50 with Device B's local LAN IP:
# RETRIEVAL_SERVICE_URL=http://192.168.1.50:8083
# OLLAMA_URL=http://192.168.1.50:11434

RETRIEVAL_SERVICE_URL=http://localhost:8083
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
EMBEDDING_MODEL=nomic-embed-text:latest

# Retrieval Tuning
RETRIEVAL_PORT=8083
SIMILARITY_THRESHOLD=0.55
TOP_K_CHUNKS=4

# Knowledge Files Directory (place your PDF, TXT, MD, JSON files here on Device B)
KNOWLEDGE_FILES_DIR=data-module/knowledge_files
